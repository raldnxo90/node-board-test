<!doctype html>
<html lang="ko">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>메인페이지</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>

<body>
    <%- include('partial/header') %>

        <!-- 메인 -->
        <main class="container my-4">
            <!-- 일러스트 -->
            <section class="hero p-5 mb-4">
                <div class="row align-items-center">
                    <div class="col-lg-7">
                        <h1 class="display-5 mb-3">801호 게시판</h1>
                        <p class="lead">안녕하세요</p>
                    </div>
                    <div class="col-lg-5 d-none d-lg-block">
                        <img src="image/메인.png" alt="메인 일러스트" class="img-fluid rounded shadow-sm">
                    </div>
                </div>
            </section>
            <div class="d-flex justify-content-between align-items-center mb-4 mt-1">
                <div class="d-flex flex-wrap gap-2 mb-4 mt-1">
                    <a href="/board/list/free" class="btn btn-brand btn-lg">자유게시판</a>
                    <a href="/board/list/study" class="btn btn-brand btn-lg">학업게시판</a>
                    <a href="/board/list/suggestion" class="btn btn-brand btn-lg">건의게시판</a>
                    <a href="/board/list/counsel" class="btn btn-brand btn-lg">상담게시판</a>
                </div>
            </div>

            <hr class="my-4">

            <!-- 최신게시글 6개 -->
            <div class="row g-3">
                <% if (mainBoards.length===0) { %>
                    <p class="text-center text-muted">게시글이 없습니다.</p>
                    <% } else { %>
                        <% mainBoards.forEach(board=> { %>
                            <div class="col-md-4">
                                <div class="card h-100 shadow-sm">
                                    <% if (board.file) { %>
                                        <img src="/uploads/board/<%= board.file %>" class="card-img-top" alt="게시글 이미지">
                                        <% } else { %>
                                            <div class="placeholder-img card-img-top">이미지 없음</div>
                                            <% } %>
                                                <div class="card-body">
                                                    <h6 class="card-title">
                                                        <%= board.title %>
                                                    </h6>
                                                    <p class="card-text small text-muted">
                                                        <%= board.author?.name || '탈퇴한 회원' %> · <%=
                                                                board.createdAt.toLocaleDateString() %>
                                                    </p>
                                                    <a class="stretched-link" href="/board/info/<%= board._id %>"></a>
                                                </div>
                                </div>
                            </div>
                            <% }) %>
                                <% } %>
            </div>
        </main>

        <%- include('partial/footer') %>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>