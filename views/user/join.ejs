<!doctype html>
<html lang="ko">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>register</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>

<body>

    <%- include('../partial/header') %>

        <main class="container my-4">
            <div class="row justify-content-center">
                <div class="col-md-7 col-lg-6">
                    <div class="card shadow-sm">
                        <div class="card-body p-4">
                            <h4 class="mb-3">회원가입</h4>

                            <form action="/user/join" method="post" enctype="multipart/form-data">
                                <div class="row g-3">

                                    <!-- 이메일 -->
                                    <div class="col-12">
                                        <label class="form-label">이메일 <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <input type="text"
                                                class="form-control <%= errors && errors.email ? 'is-invalid' : '' %>"
                                                name="email" id="emailInput""
                                                placeholder="이메일을 입력하세요" />
                                            <button type="button" class="btn btn-outline-secondary" id="checkEmailBtn">
                                                중복확인
                                            </button>
                                        </div>
                                        <div id="emailFeedback" class="form-text"></div>
                                        <% if (errors && errors.email) { %>
                                            <div class="form-text text-danger">
                                                <%= errors.email %>
                                            </div>
                                            <% } %>
                                    </div>

                                    <!-- 비밀번호 -->
                                    <div class="col-12">
                                        <label class="form-label">비밀번호 <span class="text-danger">*</span></label>
                                        <input type="password"
                                            class="form-control <%= errors && errors.password ? 'is-invalid' : '' %>"
                                            name="password" placeholder="비밀번호를 입력하세요" />
                                        <small class="text-muted">영문, 숫자, 특수문자 조합 8자 이상</small>
                                        <% if (errors && errors.password) { %>
                                            <div class="form-text text-danger">
                                                <%= errors.password %>
                                            </div>
                                            <% } %>
                                    </div>

                                    <!-- 비밀번호 확인 -->
                                    <div class="col-12">
                                        <label class="form-label">비밀번호 확인 <span class="text-danger">*</span></label>
                                        <input type="password"
                                            class="form-control <%= errors && errors.confirmPassword ? 'is-invalid' : '' %>"
                                            name="confirmPassword" placeholder="비밀번호를 다시 입력하세요" />
                                        <% if (errors && errors.confirmPassword) { %>
                                            <div class="form-text text-danger">
                                                <%= errors.confirmPassword %>
                                            </div>
                                            <% } %>
                                    </div>

                                    <!-- 이름 -->
                                    <div class="col-12">
                                        <label class="form-label">이름 <span class="text-danger">*</span></label>
                                        <input type="text"
                                            class="form-control <%= errors && errors.name ? 'is-invalid' : '' %>"
                                            name="name" placeholder="이름을 입력하세요" />
                                        <% if (errors && errors.name) { %>
                                            <div class="form-text text-danger">
                                                <%= errors.name %>
                                            </div>
                                            <% } %>
                                    </div>

                                    <!-- 주소 -->
                                    <div class="col-12">
                                        <label class="form-label">주소</label>
                                        <input type="text" class="form-control" name="address"
                                            placeholder="주소를 입력하세요" />
                                    </div>

                                    <div class="col-12 text-center mb-3">
                                        <img id="previewImg" src="/image/default-profile.png" class="rounded-circle mb-2" style="width:100px; height:100px; object-fit:cover;">
                                        <div>
                                            <label for="profileImage" class="btn btn-outline-secondary btn-sm">
                                                사진 선택
                                            </label>
                                            <input type="file" id="profileImage" name="profileImage" accept="image/*" class="d-none">
                                        </div>
                                    </div>

                                </div>

                                <div class="d-grid mt-4">
                                    <button type="submit" class="btn btn-brand">가입하기</button>
                                </div>
                            </form>

                        </div>
                    </div>
                </div>
            </div>
        </main>

        <%- include('../partial/footer') %>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

            <script>
                const emailInput = document.getElementById('emailInput');
                const checkBtn = document.getElementById('checkEmailBtn');
                const feedback = document.getElementById('emailFeedback');
                let isEmailChecked = false; // 중복확인 통과 여부

                checkBtn.addEventListener('click', async () => {
                    const email = emailInput.value.trim();

                    // 간단한 형식 체크
                    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                    if (!email || !emailRegex.test(email)) {
                        feedback.textContent = '올바른 이메일 형식을 입력해주세요.';
                        feedback.className = 'form-text text-danger';
                        return;
                    }

                    try {
                        const res = await fetch(`/user/check-email?email=${encodeURIComponent(email)}`);
                        const data = await res.json(); // { available: true/false }

                        if (data.available) {
                            feedback.textContent = '사용 가능한 이메일입니다.';
                            feedback.className = 'form-text text-success';
                            isEmailChecked = true;
                            emailInput.readOnly = true; // 확인 후 수정 못 하게
                            checkBtn.disabled = true;
                        } else {
                            feedback.textContent = '이미 사용 중인 이메일입니다.';
                            feedback.className = 'form-text text-danger';
                            isEmailChecked = false;
                        }
                    } catch (err) {
                        feedback.textContent = '서버 오류가 발생했습니다.';
                        feedback.className = 'form-text text-danger';
                    }
                });

                // 이메일 직접 수정 시 확인 상태 초기화
                emailInput.addEventListener('input', () => {
                    isEmailChecked = false;
                    feedback.textContent = '';
                    emailInput.readOnly = false;
                    checkBtn.disabled = false;
                });

                // 폼 제출 시 중복확인 여부 검사
                document.querySelector('form').addEventListener('submit', (e) => {
                    if (!isEmailChecked) {
                        e.preventDefault();
                        feedback.textContent = '이메일 중복확인을 해주세요.';
                        feedback.className = 'form-text text-danger';
                    }
                });

            </script>

            <!-- 미리보기 스크립트 -->
            <script>
                document.getElementById('profileImage').addEventListener('change', (e) => {
                    const file = e.target.files[0];
                    //e.target === document.getElementById('profileImage') : 이벤트가 일어난 요소
                    //files[0] : 선택된 파일 중 첫 번째 파일 (여러 개 선택 가능 시 첫 번째 파일을 가져옴)
                    if (file) {
                        const reader = new FileReader();// FileReader: 파일을 읽는 자바스크립트 내장 객체
                        reader.onload = (e) => {// onload: 파일이 읽혀졌을 때 실행되는 콜백 함수
                            document.getElementById('previewImg').src = e.target.result;// e.target.result: 읽혀진 파일의 데이터 URL
                        };
                        reader.readAsDataURL(file);// readAsDataURL: 파일을 읽어서 데이터 URL로 변환 (이미지 미리보기용)
                    }
                });
            </script>

</body>

</html>