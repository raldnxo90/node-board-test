<!doctype html>
<html lang="ko">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>회원정보</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>

<body>

    <!-- 헤더 -->
    <%- include('../partial/header') %>

        <main class="container my-4">
            <div class="card shadow-sm mb-4">
                <div class="card-body text-center">
                    <!-- <img src="/uploads/profile/<%= user.profileImage %>" alt="프로필 이미지" class="rounded-circle mb-3"
                        style="width: 120px; height: 120px; object-fit: cover;"> -->
                        <img src="<%= user.provider !== 'local' ? user.profileImage : '/uploads/profile/' + user.profileImage %>">
                    
                    <div class="small text-muted mb-2">
                        <%= user.email %>
                    </div>

                    <!-- 추가 필드: 이름 / 주소 -->
                    <p class="mb-1">이름 : <strong>
                            <%= user.name %>
                        </strong></p>
                    <p class="mb-0">주소 : <strong>
                            <%= user.address %>
                        </strong></p>

                    <a class="btn btn-sm btn-brand mt-3" href="/user/modify">회원정보 수정</a>
                    <a class="btn btn-sm btn-brand mt-3" href="/user/delete">회원탈퇴</a>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="mb-3">내가 쓴 글</h5>
                    <ul class="list-group list-group-flush">

                        <% boards.forEach(board=> { %>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <a class="page-link" href="/board/info/<%= board._id %>">
                                    <%= board.title %>
                                </a>
                                <span class="small text-muted">
                                    <%= new Date(board.createdAt).toLocaleDateString() %>
                                </span>
                            </li>
                        <% }) %>
                        
                    </ul>
                </div>
            </div>

            <!-- 페이징 -->
            <nav aria-label="게시글 페이지" class="mt-3">
                <ul class="pagination justify-content-center">

                    <!-- 이전 -->
                    <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                        <a class="page-link" href="/user/info?page=<%= currentPage - 1 %>">이전</a>
                    </li>

                    <!-- 페이지 번호 -->
                    <% for (let i=1; i <=totalPages; i++) { %>
                        <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                            <a class="page-link" href="/user/info?page=<%= i %>">
                                <%= i %>
                            </a>
                        </li>
                    <% } %>

                    <!-- 다음 -->
                    <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                        <a class="page-link" href="/user/info?page=<%= currentPage + 1 %>">다음</a>
                    </li>

                </ul>
            </nav>

        </main>

        <%- include('../partial/footer') %>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>